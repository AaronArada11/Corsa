<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.corsa.app.ui.dashboard.DashboardFragment"
        android:label="@string/dashboard_tab_dashboard" />

    <fragment
        android:id="@+id/vehicleListFragment"
        android:name="com.corsa.app.ui.vehicles.VehicleListFragment"
        android:label="@string/vehicles_title" />

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.corsa.app.ui.analytics.AnalyticsFragment"
        android:label="@string/dashboard_tab_analytics" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.corsa.app.ui.settings.SettingsFragment"
        android:label="@string/dashboard_settings" />

    <fragment
        android:id="@+id/vehicleEditorFragment"
        android:name="com.corsa.app.ui.vehicles.VehicleEditorFragment"
        android:label="@string/edit_vehicle">
        <argument
            android:name="vehicleId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/vehicleDetailsFragment"
        android:name="com.corsa.app.ui.vehicles.VehicleDetailsFragment"
        android:label="@string/vehicle_details_title">
        <argument
            android:name="vehicleId"
            app:argType="long" />
    </fragment>
    <fragment android:id="@+id/documentEditorFragment" android:name="com.corsa.app.ui.vehicles.DocumentEditorFragment" android:label="@string/document_editor_title">
        <argument android:name="vehicleId" app:argType="long" />
        <argument android:name="documentId" android:defaultValue="0L" app:argType="long" />
    </fragment>
</navigation>
