<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dashboard_empty_backdrop"
    tools:theme="@style/Theme.Corsa.EmptyDashboard">

    <ScrollView
        android:id="@+id/dashboardContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="560dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/emptyDashboardContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintWidth_max="480dp"
                app:layout_constraintVertical_bias="0.40"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/emptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="balanced"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/dashboard_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="@string/dashboard_empty_title" />

                <ImageView
                    android:id="@+id/emptyVehicleImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:adjustViewBounds="true"
                    android:maxHeight="500dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/dashboard_vehicle" />

                <TextView
                    android:id="@+id/emptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxWidth="320dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/dashboard_text_secondary"
                    android:textSize="16sp"
                    tools:text="@string/dashboard_empty_message" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addVehicleButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:minWidth="220dp"
                    android:minHeight="56dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"
                    android:textAllCaps="false"
                    android:textColor="@color/dashboard_on_button"
                    android:textSize="16sp"
                    app:backgroundTint="@color/dashboard_button"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/dashboard_ic_add_vehicle"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/dashboard_on_button"
                    app:rippleColor="@color/dashboard_ripple"
                    app:strokeWidth="0dp"
                    tools:text="@string/dashboard_add_vehicle" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/dashboardProgress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/dashboard_selected" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <include
        android:id="@+id/populatedDashboard"
        layout="@layout/dashboard_populated"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
