<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/corsa_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/document_editor_title" app:navigationIcon="?attr/homeAsUpIndicator" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/documentFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <EditText android:id="@+id/documentTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/document_title" android:inputType="textCapSentences" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/document_type" android:labelFor="@id/documentType" />
            <Spinner android:id="@+id/documentType" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
            <EditText android:id="@+id/documentNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/document_number" android:inputType="text" />
            <EditText android:id="@+id/documentIssueDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/document_issue_date" android:inputType="date" />
            <EditText android:id="@+id/documentExpirationDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/document_expiration_date" android:inputType="date" />
            <EditText android:id="@+id/documentCost" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/document_cost" android:inputType="numberDecimal" />
            <EditText android:id="@+id/documentLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/document_location" android:inputType="textCapSentences" />
            <EditText android:id="@+id/documentDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:gravity="top" android:hint="@string/document_description" android:inputType="textCapSentences|textMultiLine" />
            <com.google.android.material.button.MaterialButton android:id="@+id/documentAttach" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/document_attach" />
            <TextView android:id="@+id/documentAttachment" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/documentError" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:textColor="?attr/colorError" />
            <com.google.android.material.button.MaterialButton android:id="@+id/documentSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
