<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/corsa_background" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.38"
                android:gradientRadius="360dp"
                android:startColor="@color/corsa_surface_variant"
                android:centerColor="@color/corsa_surface"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

</layer-list>
